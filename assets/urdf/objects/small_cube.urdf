<?xml version="1.0"?>
<robot name="small_cube">
  <link name="cube_body">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/small_cube.obj" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <!-- <origin xyz="0 0 -0.039842"/> -->
      <mass value="0.124"/>
      <density value="1240"/>
      <inertia ixx="0.00020666666" ixy="0.0" ixz="0.0" iyy="0.00020666666" iyz="0.0" izz="0.00020666666"/>
    </inertial>
  </link>
</robot>